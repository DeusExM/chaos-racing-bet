{
  "name": "chaos-race",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Course humoristique a 6 personnages, 100% locale et reproductible (V1).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "node tools/balanceRunner.mjs",
    "test:e2e": "node --env-file=.playwright.env node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "node --env-file=.playwright.env node_modules/@playwright/test/cli.js install chromium",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
